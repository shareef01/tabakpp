# Copy to .env.local and fill in from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — App Check (reCAPTCHA v3 site key from Firebase Console → App Check)
# Recommended on Spark; set the site key before enforcing App Check in Console.
# Debug tokens must be set explicitly — never auto-minted.
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

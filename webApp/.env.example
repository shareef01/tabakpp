# Copy to .env.local and fill in from Firebase Console → Project settings
#
# These six client identifiers are the ONLY required configuration. The project
# is Spark-only: Auth + Firestore + Hosting, authorized by Firestore Security
# Rules. App Check is deliberately not used (no attestation provider, no token,
# no enforcement), so there are no App Check variables to set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — Option B trusted ledger (off by default; needs the Cloud Functions
# in ../functions deployed, which requires Blaze — production stays on Spark).
# VITE_OPTION_B_LEDGER=1
# Point the callables at the local Functions emulator instead of production.
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001

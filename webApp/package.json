{
  "name": "tabakpp",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contract": "vitest run src/utils/domainFixtures.contract.test.js",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore \"vitest run --config vitest.rules.config.js\"",
    "build:demo": "vite build --config vite.screenshot.config.js",
    "screenshots": "npm run build:demo && node scripts/screenshot.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2"
  }
}

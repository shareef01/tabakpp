# ==============================================================================
# TABAK++ Staging Environment Template
# ==============================================================================
# Copy this file to .env.staging.local when configuring staging:
#   cp webApp/.env.staging.example webApp/.env.staging.local
#
# IMPORTANT:
# - Do NOT commit .env.staging.local or any file containing real API keys/tokens.
# - Do NOT reuse keys from the production project.
# - Vite build with `--mode staging` inlines these variables.
# - .env.staging.local takes precedence over .env.staging and .env.local.
# ==============================================================================

# Required: Isolated Firebase Web App configuration for project "tabakpp-staging"
# Retrieve these values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tabakpp-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tabakpp-staging
VITE_FIREBASE_STORAGE_BUCKET=tabakpp-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: not used
# The clients ship without App Check (no provider, no token), so there is no
# site key to configure — in staging or in production.

# Spark / LEGACY Architecture
# Leave VITE_OPTION_B_LEDGER UNSET.
# Cloud Functions and Option-B ledger migrations are disabled to maintain
# strict parity with the production Spark tier.
# VITE_OPTION_B_LEDGER=

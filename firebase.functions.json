{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs24",
    "predeploy": [
      "node scripts/guard-functions-deploy.mjs"
    ]
  }
}

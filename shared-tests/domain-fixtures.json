        "defaultUnitPrice": 0.5
      },
      "expected": { "wasted": 0.0, "saved": 0.0, "smokingUnits": 3.0, "baselineSaved": 0.0 } },
    { "case": "day_credit_unknown_tracker_contributes_nothing", "op": "dayCredit",
      "input": {
        "counts": { "c1": 5, "ghost": 9 },
        "trackerSnapshots": { "c1": { "target": 10, "baseline": null, "unitPrice": 1.0, "type": "CIGARETTE", "isFinanciallyTracked": true } },
        "defaultUnitPrice": 0.5
      },
      "expected": { "wasted": 5.0, "saved": 5.0, "smokingUnits": 5.0, "baselineSaved": 0.0 } },


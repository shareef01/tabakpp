{
  "$schema": "Cross-platform domain contract fixtures — see shared-tests/README.md.",
  "fixtures": [
    { "case": "tracking_date_before_daystart_previous_day", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 20, 5, 59, 0], "dayStartHour": 6 },
      "expected": "2024-05-19" },
    { "case": "tracking_date_at_daystart_same_day", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 20, 6, 0, 0], "dayStartHour": 6 },
      "expected": "2024-05-20" },
    { "case": "tracking_date_late_night_same_day", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 20, 23, 59, 0], "dayStartHour": 6 },
      "expected": "2024-05-20" },
    { "case": "tracking_date_custom_daystart_midnight_previous_day", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 20, 23, 30, 0], "dayStartHour": 0 },
      "expected": "2024-05-20" },
    { "case": "tracking_date_custom_daystart_noon", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 20, 11, 59, 0], "dayStartHour": 12 },
      "expected": "2024-05-19" },
    { "case": "tracking_date_default_daystart_midnight_is_previous_day", "op": "trackingDate",
      "input": { "localDateTime": [2024, 5, 21, 0, 0, 0], "dayStartHour": 6 },
      "expected": "2024-05-20" },

    { "case": "zero_target_at_zero_actual", "op": "limitStatus",

rules_version = '2';
// Deploy: firebase deploy --only firestore:rules
//
// App Check is integrated on both clients but enforcement is DELIBERATELY OFF —
// do not turn it on in the Console as a "hardening" pass. Android release APKs
// use the debug provider (Play Integrity needs a Play Console link), so
// enforcing would break every APK downloaded from GitHub Releases. These rules
// plus API-key restrictions are the security boundary. See README → Security
// and SETUP_GUIDE.md for the upgrade path.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    // Web JS numbers are floats; Android may write ints. Accept whole numbers either way.
    function isWholeNumber(v) {
      return isNumber(v) && v % 1 == 0;
    }

    function boundNumber(v, maxAbs) {
      return isNumber(v) && v >= -maxAbs && v <= maxAbs;
    }

    function validLifetimeAggregates(a) {
      return a is map
        && a.keys().hasOnly(['saved', 'wasted', 'smokingUnits'])
        && (!('saved' in a) || boundNumber(a.saved, 100000000))
        && (!('wasted' in a) || boundNumber(a.wasted, 100000000))
        && (!('smokingUnits' in a) || (isNumber(a.smokingUnits) && a.smokingUnits >= 0 && a.smokingUnits <= 100000000));
    }

    // Fresh profile bootstrap — no forged lifetime totals on create.
    function zeroAggregates(a) {
      return a is map
        && a.keys().hasOnly(['saved', 'wasted', 'smokingUnits'])
        && (!('saved' in a) || a.saved == 0)
        && (!('wasted' in a) || a.wasted == 0)
        && (!('smokingUnits' in a) || a.smokingUnits == 0);
    }

    // Dynamic tracker ids — bound size, keys, and each numeric value (matches
    // InputSanitizer.counts). Rules forbid recursion, so lists are unrolled.
    function validCountValue(v) {
      return isNumber(v) && v >= 0 && v <= 10000;
    }

    function validCountKey(k) {
      return k is string
        && k.size() >= 1
        && k.size() <= 64
        && k.matches('^[A-Za-z0-9_-]+$');
    }

    function validCountEntries(keys, vals) {
      let n = vals.size();
      return n <= 50
        && keys.size() == n
        && (n < 1 || (validCountKey(keys[0]) && validCountValue(vals[0])))
        && (n < 2 || (validCountKey(keys[1]) && validCountValue(vals[1])))
        && (n < 3 || (validCountKey(keys[2]) && validCountValue(vals[2])))
        && (n < 4 || (validCountKey(keys[3]) && validCountValue(vals[3])))
        && (n < 5 || (validCountKey(keys[4]) && validCountValue(vals[4])))
        && (n < 6 || (validCountKey(keys[5]) && validCountValue(vals[5])))
        && (n < 7 || (validCountKey(keys[6]) && validCountValue(vals[6])))
        && (n < 8 || (validCountKey(keys[7]) && validCountValue(vals[7])))
        && (n < 9 || (validCountKey(keys[8]) && validCountValue(vals[8])))
        && (n < 10 || (validCountKey(keys[9]) && validCountValue(vals[9])))
        && (n < 11 || (validCountKey(keys[10]) && validCountValue(vals[10])))
        && (n < 12 || (validCountKey(keys[11]) && validCountValue(vals[11])))
        && (n < 13 || (validCountKey(keys[12]) && validCountValue(vals[12])))
        && (n < 14 || (validCountKey(keys[13]) && validCountValue(vals[13])))
        && (n < 15 || (validCountKey(keys[14]) && validCountValue(vals[14])))
        && (n < 16 || (validCountKey(keys[15]) && validCountValue(vals[15])))
        && (n < 17 || (validCountKey(keys[16]) && validCountValue(vals[16])))
        && (n < 18 || (validCountKey(keys[17]) && validCountValue(vals[17])))
        && (n < 19 || (validCountKey(keys[18]) && validCountValue(vals[18])))
        && (n < 20 || (validCountKey(keys[19]) && validCountValue(vals[19])))
        && (n < 21 || (validCountKey(keys[20]) && validCountValue(vals[20])))
        && (n < 22 || (validCountKey(keys[21]) && validCountValue(vals[21])))
        && (n < 23 || (validCountKey(keys[22]) && validCountValue(vals[22])))
        && (n < 24 || (validCountKey(keys[23]) && validCountValue(vals[23])))
        && (n < 25 || (validCountKey(keys[24]) && validCountValue(vals[24])))
        && (n < 26 || (validCountKey(keys[25]) && validCountValue(vals[25])))
        && (n < 27 || (validCountKey(keys[26]) && validCountValue(vals[26])))
        && (n < 28 || (validCountKey(keys[27]) && validCountValue(vals[27])))
        && (n < 29 || (validCountKey(keys[28]) && validCountValue(vals[28])))
        && (n < 30 || (validCountKey(keys[29]) && validCountValue(vals[29])))
        && (n < 31 || (validCountKey(keys[30]) && validCountValue(vals[30])))
        && (n < 32 || (validCountKey(keys[31]) && validCountValue(vals[31])))
        && (n < 33 || (validCountKey(keys[32]) && validCountValue(vals[32])))
        && (n < 34 || (validCountKey(keys[33]) && validCountValue(vals[33])))
        && (n < 35 || (validCountKey(keys[34]) && validCountValue(vals[34])))
        && (n < 36 || (validCountKey(keys[35]) && validCountValue(vals[35])))
        && (n < 37 || (validCountKey(keys[36]) && validCountValue(vals[36])))
        && (n < 38 || (validCountKey(keys[37]) && validCountValue(vals[37])))
        && (n < 39 || (validCountKey(keys[38]) && validCountValue(vals[38])))
        && (n < 40 || (validCountKey(keys[39]) && validCountValue(vals[39])))
        && (n < 41 || (validCountKey(keys[40]) && validCountValue(vals[40])))
        && (n < 42 || (validCountKey(keys[41]) && validCountValue(vals[41])))
        && (n < 43 || (validCountKey(keys[42]) && validCountValue(vals[42])))
        && (n < 44 || (validCountKey(keys[43]) && validCountValue(vals[43])))
        && (n < 45 || (validCountKey(keys[44]) && validCountValue(vals[44])))
        && (n < 46 || (validCountKey(keys[45]) && validCountValue(vals[45])))
        && (n < 47 || (validCountKey(keys[46]) && validCountValue(vals[46])))
        && (n < 48 || (validCountKey(keys[47]) && validCountValue(vals[47])))
        && (n < 49 || (validCountKey(keys[48]) && validCountValue(vals[48])))
        && (n < 50 || (validCountKey(keys[49]) && validCountValue(vals[49])));
    }

    function validCountMap(counts) {
      return counts is map
        && counts.size() <= 50
        && validCountEntries(counts.keys(), counts.values());
    }

    // Canonical UserProfile keys (shared Android/KMP + web).
    // Legacy web-only eco fields may still exist on older docs; allowed so
    // updates are not blocked until clients deleteField them.
    function validUserKeys(data) {
      return data.keys().hasOnly([
        'name', 'accent', 'widgetSize', 'purchaseType', 'unitPrice', 'unitsPerPack',
        'pouchPrice', 'estimatedYield', 'dayStartHour', 'activeCounts',
        'lifetimeAggregates', 'smokingUnitsMigrated', 'avatar', 'createdAt', 'updatedAt',
        'ecoMode', 'retailPrice', 'retailQty', 'ryoPrice', 'ryoYield'
      ]);
    }

    function validSettingsShape(d) {
      return (!('name' in d) || (d.name is string && d.name.size() <= 100))
        && (!('accent' in d) || (d.accent is string && d.accent.matches('^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$')))
        && (!('purchaseType' in d) || d.purchaseType in ['PACK', 'POUCH'])
        && (!('dayStartHour' in d) || (isWholeNumber(d.dayStartHour) && d.dayStartHour >= 0 && d.dayStartHour <= 23))
        && (!('unitPrice' in d) || (isNumber(d.unitPrice) && d.unitPrice >= 0 && d.unitPrice <= 1000))
        && (!('unitsPerPack' in d) || (isWholeNumber(d.unitsPerPack) && d.unitsPerPack >= 1 && d.unitsPerPack <= 1000))
        && (!('pouchPrice' in d) || (isNumber(d.pouchPrice) && d.pouchPrice >= 0 && d.pouchPrice <= 10000))
        && (!('estimatedYield' in d) || (isWholeNumber(d.estimatedYield) && d.estimatedYield >= 0 && d.estimatedYield <= 10000))
        && (!('widgetSize' in d) || d.widgetSize in ['SMALL', 'MEDIUM', 'LARGE'])
        && (!('avatar' in d) || d.avatar == null || (d.avatar is string && d.avatar.size() <= 100000));
    }

    function validUserProfile() {
      let d = request.resource.data;
      return validUserKeys(d)
        && validSettingsShape(d)
        && (!('lifetimeAggregates' in d) || validLifetimeAggregates(d.lifetimeAggregates))
        && (!('activeCounts' in d) || validCountMap(d.activeCounts))
        && (!('smokingUnitsMigrated' in d) || d.smokingUnitsMigrated is bool);
    }

    function validCreateProfile() {
      let d = request.resource.data;
      return validUserProfile()
        && (!('activeCounts' in d) || d.activeCounts.size() == 0)
        && (!('lifetimeAggregates' in d) || zeroAggregates(d.lifetimeAggregates));
    }

    // Counter/archive path: only validate fields this write may change.
    // Do NOT re-check avatar/name/legacy keys — a large avatar otherwise
    // blocks every increment even though activeCounts is the only change.
    function validMutationUpdate() {
      let d = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['activeCounts']) || validCountMap(d.activeCounts))
        && (!changed.hasAny(['lifetimeAggregates']) || validLifetimeAggregates(d.lifetimeAggregates))
        && (!changed.hasAny(['smokingUnitsMigrated']) || d.smokingUnitsMigrated is bool);
    }

    // Settings path: validate only fields this write changes (parity with
    // validMutationUpdate). Do NOT re-check activeCounts / aggregates / an
    // existing oversized avatar — those would brick every settings save.
    function validSettingsUpdate() {
      let d = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['name']) || (d.name is string && d.name.size() <= 100))
        && (!changed.hasAny(['accent'])
          || (d.accent is string && d.accent.matches('^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$')))
        && (!changed.hasAny(['purchaseType']) || d.purchaseType in ['PACK', 'POUCH'])
        && (!changed.hasAny(['dayStartHour'])
          || (isWholeNumber(d.dayStartHour) && d.dayStartHour >= 0 && d.dayStartHour <= 23))
        && (!changed.hasAny(['unitPrice'])
          || (isNumber(d.unitPrice) && d.unitPrice >= 0 && d.unitPrice <= 1000))
        && (!changed.hasAny(['unitsPerPack'])
          || (isWholeNumber(d.unitsPerPack) && d.unitsPerPack >= 1 && d.unitsPerPack <= 1000))
        && (!changed.hasAny(['pouchPrice'])
          || (isNumber(d.pouchPrice) && d.pouchPrice >= 0 && d.pouchPrice <= 10000))
        && (!changed.hasAny(['estimatedYield'])
          || (isWholeNumber(d.estimatedYield) && d.estimatedYield >= 0 && d.estimatedYield <= 10000))
        && (!changed.hasAny(['widgetSize']) || d.widgetSize in ['SMALL', 'MEDIUM', 'LARGE'])
        && (!changed.hasAny(['avatar'])
          || d.avatar == null
          || (d.avatar is string && d.avatar.size() <= 100000));
    }

    // Spark-safe defense (no Cloud Functions): settings writes cannot touch
    // counters/aggregates, and mutation writes cannot touch identity/economics.
    // Owners can still forge aggregates in a dedicated mutation write on Spark;
    // App Check + API key restrictions are the remaining mitigations.
    // 'createdAt' is deliberately absent: it is set once at profile creation and
    // a settings save has no business rewriting account age.
    function isSettingsOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'name', 'accent', 'widgetSize', 'purchaseType', 'unitPrice', 'unitsPerPack',
          'pouchPrice', 'estimatedYield', 'dayStartHour', 'avatar', 'updatedAt',
          'ecoMode', 'retailPrice', 'retailQty', 'ryoPrice', 'ryoYield'
        ]);
    }

    function isMutationOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'activeCounts', 'lifetimeAggregates', 'smokingUnitsMigrated', 'updatedAt'
        ]);
    }

    function validLogEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'logDate', 'counts', 'origin', 'finalizedAt', 'clientTimestamp', 'id',
          'isArchive', 'isManual', 'aggregateCredit'
        ])
        && d.keys().hasAll(['logDate', 'counts'])
        && d.logDate is string
        && d.logDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validCountMap(d.counts)
        && (!('origin' in d) || d.origin in ['DAY_RESET', 'MANUAL_ENTRY'])
        && (!('isArchive' in d) || d.isArchive is bool)
        && (!('isManual' in d) || d.isManual is bool)
        // Same shape and bounds as the profile totals it accumulates into.
        && (!('aggregateCredit' in d) || validLifetimeAggregates(d.aggregateCredit));
    }

    function validConfig() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'limit', 'order', 'type', 'pricePerUnit', 'isFinanciallyTracked',
          'isPrimaryTracked', 'createdAt', 'updatedAt', 'id'
        ])
        && d.keys().hasAll(['name', 'limit', 'order'])
        && d.name is string
        && d.name.size() <= 80
        && isWholeNumber(d.limit)
        && d.limit >= 0
        && d.limit <= 10000
        && isWholeNumber(d.order)
        && d.order >= 0
        && d.order <= 1000
        && (!('type' in d) || d.type in ['CIGARETTE', 'RYO_ROLL', 'JOINT_KING', 'SIMPLE'])
        && (!('pricePerUnit' in d) || d.pricePerUnit == null || (isNumber(d.pricePerUnit) && d.pricePerUnit >= 0 && d.pricePerUnit <= 1000))
        && (!('isFinanciallyTracked' in d) || d.isFinanciallyTracked is bool)
        && (!('isPrimaryTracked' in d) || d.isPrimaryTracked is bool);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validCreateProfile();
      allow update: if isOwner(userId) && (
        (isMutationOnlyUpdate() && validMutationUpdate()) ||
        (isSettingsOnlyUpdate() && validSettingsUpdate())
      );
      allow delete: if isOwner(userId);

      match /configs/{configId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validConfig();
        allow delete: if isOwner(userId);
      }

      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validLogEntry();
        // logDate is immutable: an edit may only re-count the day it already
        // belongs to. Relabelling a log to another date would move counts
        // between days while lifetimeAggregates stayed put.
        allow update: if isOwner(userId)
          && validLogEntry()
          && request.resource.data.logDate == resource.data.logDate;
        allow delete: if isOwner(userId);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

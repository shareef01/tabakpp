<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP traffic to Firebase emulators running on the host.
         10.0.2.2 is the Android emulator's loopback to the host's localhost.
         127.0.0.1 is used when adb reverse forwards emulator ports to host (CI).
         The Auth emulator runs on HTTP (port 9099), so cleartext is required. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
